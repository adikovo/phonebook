# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored so secrets stay local.

# MongoDB Atlas connection string.
# Replace <db_password> with your actual password and add `/phonebook` as the database name.
MONGODB_URI=mongodb+srv://adikovo_db_user:<db_password>@cluster0.8eqtv7c.mongodb.net/phonebook?appName=Cluster0

# Port the Express server listens on (the Vite dev server proxies /api and /uploads here).
PORT=4000
